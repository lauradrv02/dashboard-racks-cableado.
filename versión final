<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dashboard Rack</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  
  :root {
    --primary: #6366f1;
    --primary-dark: #4f46e5;
    --primary-light: #818cf8;
    --success: #10b981;
    --warning: #f59e0b;
    --danger: #ef4444;
    --info: #3b82f6;
    --bg: #f8fafc;
    --card: #ffffff;
    --text: #1e293b;
    --text-light: #64748b;
    --border: #e2e8f0;
    --shadow: 0 4px 6px -1px rgba(0,0,0,0.07), 0 2px 4px -1px rgba(0,0,0,0.04);
    --shadow-lg: 0 10px 15px -3px rgba(0,0,0,0.1), 0 4px 6px -2px rgba(0,0,0,0.05);
  }
  
  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: linear-gradient(135deg, #f5f7fa 0%, #e8ecf4 100%);
    color: var(--text);
    min-height: 100vh;
    line-height: 1.5;
  }
  
  .header {
    background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
    color: white;
    padding: 1.25rem 2rem;
    box-shadow: var(--shadow-lg);
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .header-content {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 1.4rem;
    font-weight: 700;
  }
  .logo-icon {
    width: 42px;
    height: 42px;
    background: rgba(255,255,255,0.2);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    backdrop-filter: blur(10px);
  }
  .header-actions { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .btn {
    padding: 0.6rem 1.1rem;
    border: none;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
  }
  .btn:hover { transform: translateY(-1px); box-shadow: var(--shadow); }
  .btn-primary { background: white; color: var(--primary-dark); }
  .btn-primary:hover { background: #f1f5f9; }
  .btn-ghost { background: rgba(255,255,255,0.15); color: white; backdrop-filter: blur(10px); }
  .btn-ghost:hover { background: rgba(255,255,255,0.25); }
  .btn-success { background: var(--success); color: white; }
  .btn-danger { background: var(--danger); color: white; }
  .btn-secondary { background: var(--border); color: var(--text); }
  .btn-lg { padding: 0.85rem 1.5rem; font-size: 1rem; }
  .btn-sm { padding: 0.4rem 0.75rem; font-size: 0.8rem; }
  
  .save-indicator {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.8rem;
    background: rgba(16, 185, 129, 0.2);
    border-radius: 20px;
    font-size: 0.8rem;
    color: #d1fae5;
  }
  .save-dot {
    width: 8px;
    height: 8px;
    background: var(--success);
    border-radius: 50%;
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }
  
  .container { max-width: 1400px; margin: 0 auto; padding: 1.5rem; }
  
  .tabs {
    display: flex;
    gap: 0.25rem;
    background: var(--card);
    padding: 0.4rem;
    border-radius: 12px;
    margin-bottom: 1.5rem;
    box-shadow: var(--shadow);
    overflow-x: auto;
  }
  .tab {
    padding: 0.7rem 1.2rem;
    border: none;
    background: transparent;
    border-radius: 8px;
    cursor: pointer;
    font-weight: 600;
    color: var(--text-light);
    transition: all 0.2s;
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
  }
  .tab:hover { background: #f1f5f9; color: var(--text); }
  .tab.active {
    background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
    color: white;
    box-shadow: var(--shadow);
  }
  
  .card {
    background: var(--card);
    border-radius: 16px;
    padding: 1.5rem;
    box-shadow: var(--shadow);
    margin-bottom: 1.5rem;
  }
  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid var(--border);
    flex-wrap: wrap;
    gap: 1rem;
  }
  .card-title { font-size: 1.2rem; font-weight: 700; display: flex; align-items: center; gap: 0.6rem; }
  .card-subtitle { color: var(--text-light); font-size: 0.9rem; margin-top: 0.2rem; }
  
  .tab-content { display: none; animation: fadeIn 0.3s; }
  .tab-content.active { display: block; }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  
  .kpi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .kpi {
    background: var(--card);
    padding: 1.25rem;
    border-radius: 14px;
    box-shadow: var(--shadow);
    position: relative;
    overflow: hidden;
    transition: all 0.25s;
    cursor: pointer;
    border: 2px solid transparent;
  }
  .kpi:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--primary-light);
  }
  .kpi-click-hint {
    position: absolute;
    top: 0.6rem;
    right: 0.75rem;
    font-size: 0.7rem;
    color: var(--text-light);
    opacity: 0;
    transition: opacity 0.2s;
    display: flex;
    align-items: center;
    gap: 0.2rem;
    background: #f1f5f9;
    padding: 0.15rem 0.5rem;
    border-radius: 10px;
  }
  .kpi:hover .kpi-click-hint { opacity: 1; }
  .kpi-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    margin-bottom: 0.75rem;
  }
  .kpi-label { color: var(--text-light); font-size: 0.85rem; font-weight: 500; margin-bottom: 0.3rem; }
  .kpi-value { font-size: 1.8rem; font-weight: 800; color: var(--text); }
  .kpi-trend { font-size: 0.8rem; margin-top: 0.3rem; color: var(--success); }
  .kpi-blue .kpi-icon { background: #dbeafe; color: var(--info); }
  .kpi-green .kpi-icon { background: #d1fae5; color: var(--success); }
  .kpi-yellow .kpi-icon { background: #fef3c7; color: var(--warning); }
  .kpi-purple .kpi-icon { background: #e0e7ff; color: var(--primary); }
  
  .rack-selector { display: flex; gap: 0.75rem; margin-bottom: 1.5rem; flex-wrap: wrap; }
  .rack-selector-card {
    flex: 1;
    min-width: 200px;
    background: var(--card);
    border: 2px solid var(--border);
    border-radius: 12px;
    padding: 1rem;
    cursor: pointer;
    transition: all 0.2s;
    position: relative;
  }
  .rack-selector-card:hover { border-color: var(--primary-light); transform: translateY(-2px); box-shadow: var(--shadow); }
  .rack-selector-card.active {
    border-color: var(--primary);
    background: linear-gradient(135deg, #eef2ff 0%, #e0e7ff 100%);
    box-shadow: 0 0 0 3px rgba(99,102,241,0.1);
  }
  .rack-selector-card.active::after {
    content: '✓';
    position: absolute;
    top: 0.5rem;
    right: 0.75rem;
    background: var(--primary);
    color: white;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    font-weight: 700;
  }
  .rack-selector-name { font-weight: 700; font-size: 1rem; margin-bottom: 0.25rem; display: flex; align-items: center; gap: 0.4rem; }
  .rack-selector-location { font-size: 0.8rem; color: var(--text-light); margin-bottom: 0.5rem; }
  .rack-selector-stats { display: flex; gap: 0.75rem; font-size: 0.78rem; color: var(--text-light); }
  .rack-selector-add {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 100px;
    border: 2px dashed var(--border);
    color: var(--text-light);
    font-weight: 600;
    gap: 0.3rem;
  }
  .rack-selector-add:hover { border-color: var(--primary); color: var(--primary); background: #f8fafc; }
  
  .rack-layout { display: grid; grid-template-columns: 1fr 320px; gap: 1.5rem; }
  @media (max-width: 900px) { .rack-layout { grid-template-columns: 1fr; } }
  .rack-visual {
    background: linear-gradient(180deg, #1e293b 0%, #0f172a 100%);
    border-radius: 14px;
    padding: 1.5rem;
    color: white;
    min-height: 500px;
  }
  .rack-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(255,255,255,0.1);
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .rack-title { font-size: 1.1rem; font-weight: 700; display: flex; align-items: center; gap: 0.5rem; }
  .rack-location-badge { background: rgba(255,255,255,0.1); padding: 0.2rem 0.6rem; border-radius: 12px; font-size: 0.75rem; font-weight: 400; }
  .rack-stats { display: flex; gap: 1rem; font-size: 0.85rem; }
  .rack-stat { display: flex; align-items: center; gap: 0.3rem; opacity: 0.8; }
  .rack-units { display: flex; flex-direction: column; gap: 2px; }
  .rack-unit { display: grid; grid-template-columns: 40px 1fr; gap: 0.5rem; align-items: center; min-height: 28px; }
  .u-number { font-family: 'Courier New', monospace; font-size: 0.75rem; color: rgba(255,255,255,0.4); text-align: right; padding-right: 0.5rem; }
  .u-slot {
    background: rgba(255,255,255,0.03);
    border: 1px dashed rgba(255,255,255,0.1);
    border-radius: 6px;
    padding: 0.4rem 0.8rem;
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.2s;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .u-slot:hover { background: rgba(255,255,255,0.08); border-color: var(--primary-light); }
  .u-slot.occupied {
    background: linear-gradient(90deg, rgba(99,102,241,0.3) 0%, rgba(99,102,241,0.1) 100%);
    border: 1px solid rgba(99,102,241,0.4);
    border-style: solid;
  }
  .u-slot.maintenance {
    background: linear-gradient(90deg, rgba(245,158,11,0.3) 0%, rgba(245,158,11,0.1) 100%);
    border: 1px solid rgba(245,158,11,0.4);
  }
  .u-slot.pending {
    background: linear-gradient(90deg, rgba(59,130,246,0.3) 0%, rgba(59,130,246,0.1) 100%);
    border: 1px solid rgba(59,130,246,0.4);
  }
  .u-slot-name { font-weight: 600; display: flex; align-items: center; gap: 0.4rem; }
  .u-slot-type { font-size: 0.75rem; opacity: 0.7; }
  .u-slot-empty { color: rgba(255,255,255,0.3); font-style: italic; }
  
  .rack-legend { background: var(--card); border-radius: 14px; padding: 1.25rem; box-shadow: var(--shadow); }
  .legend-item { display: flex; align-items: center; gap: 0.6rem; padding: 0.6rem; border-radius: 8px; margin-bottom: 0.4rem; transition: background 0.2s; }
  .legend-item:hover { background: #f8fafc; }
  .legend-dot { width: 14px; height: 14px; border-radius: 4px; }
  .legend-dot.free { background: #94a3b8; }
  .legend-dot.active { background: var(--primary); }
  .legend-dot.maintenance { background: var(--warning); }
  .legend-dot.pending { background: var(--info); }
  .legend-label { font-size: 0.9rem; flex: 1; }
  .legend-count { font-weight: 700; color: var(--text-light); }
  
  .form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; }
  .form-group { margin-bottom: 1rem; }
  .form-group label { display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.4rem; color: var(--text); }
  .form-hint { font-size: 0.75rem; color: var(--text-light); margin-top: 0.25rem; font-weight: 400; }
  .form-control {
    width: 100%;
    padding: 0.65rem 0.9rem;
    border: 2px solid var(--border);
    border-radius: 8px;
    font-size: 0.9rem;
    transition: all 0.2s;
    background: white;
    font-family: inherit;
  }
  .form-control:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 3px rgba(99,102,241,0.1); }
  .form-control.invalid { border-color: var(--danger); }
  .form-control.invalid:focus { box-shadow: 0 0 0 3px rgba(239,68,68,0.1); }
  select.form-control { cursor: pointer; }
  
  /* Custom type input */
  .custom-type-wrapper {
    display: none;
    margin-top: 0.5rem;
    padding: 0.75rem;
    background: #fef3c7;
    border-radius: 8px;
    border: 1px dashed var(--warning);
  }
  .custom-type-wrapper.active { display: block; animation: fadeIn 0.3s; }
  .custom-type-actions {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.5rem;
    align-items: center;
  }
  .custom-type-actions label {
    font-size: 0.8rem;
    color: var(--text-light);
    display: flex;
    align-items: center;
    gap: 0.3rem;
    margin: 0;
    cursor: pointer;
  }
  
  /* Custom types manager */
  .custom-types-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.5rem;
  }
  .custom-type-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.3rem 0.6rem;
    background: #e0e7ff;
    color: var(--primary-dark);
    border-radius: 16px;
    font-size: 0.78rem;
    font-weight: 600;
  }
  .custom-type-chip button {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--primary-dark);
    font-size: 0.9rem;
    padding: 0;
    line-height: 1;
    opacity: 0.6;
    transition: opacity 0.2s;
  }
  .custom-type-chip button:hover { opacity: 1; color: var(--danger); }
  
  .table-wrapper { overflow-x: auto; border-radius: 10px; }
  table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  thead { background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%); }
  th { padding: 0.85rem 1rem; text-align: left; font-weight: 700; color: var(--text); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px; }
  td { padding: 0.85rem 1rem; border-bottom: 1px solid var(--border); }
  tbody tr { transition: background 0.15s; }
  tbody tr:hover { background: #f8fafc; }
  
  .badge { display: inline-flex; align-items: center; gap: 0.3rem; padding: 0.25rem 0.65rem; border-radius: 20px; font-size: 0.75rem; font-weight: 600; }
  .badge-active { background: #d1fae5; color: #065f46; }
  .badge-maintenance { background: #fef3c7; color: #92400e; }
  .badge-pending { background: #dbeafe; color: #1e40af; }
  .badge-id { background: #f3e8ff; color: #6b21a8; font-family: 'Courier New', monospace; font-size: 0.72rem; }
  .badge-dot { width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
  
  .action-btn { padding: 0.35rem 0.6rem; border: none; border-radius: 6px; cursor: pointer; font-size: 0.8rem; transition: all 0.2s; margin-right: 0.25rem; }
  .action-edit { background: #dbeafe; color: var(--info); }
  .action-edit:hover { background: var(--info); color: white; }
  .action-delete { background: #fee2e2; color: var(--danger); }
  .action-delete:hover { background: var(--danger); color: white; }
  .action-view { background: #e0e7ff; color: var(--primary); }
  .action-view:hover { background: var(--primary); color: white; }
  
  .modal-overlay {
    display: none;
    position: fixed;
    top: 0; left: 0;
    width: 100%; height: 100%;
    background: rgba(15, 23, 42, 0.6);
    backdrop-filter: blur(4px);
    z-index: 1000;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }
  .modal-overlay.active { display: flex; animation: fadeIn 0.2s; }
  .modal {
    background: var(--card);
    border-radius: 16px;
    padding: 2rem;
    max-width: 650px;
    width: 100%;
    max-height: 90vh;
    overflow-y: auto;
    box-shadow: var(--shadow-lg);
    animation: slideUp 0.3s;
  }
  .modal.modal-lg { max-width: 1000px; }
  @keyframes slideUp {
    from { transform: translateY(20px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }
  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid var(--border);
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .modal-title { font-size: 1.3rem; font-weight: 700; display: flex; align-items: center; gap: 0.5rem; }
  .modal-count { background: var(--primary); color: white; padding: 0.2rem 0.7rem; border-radius: 20px; font-size: 0.85rem; font-weight: 700; }
  .modal-close {
    background: none;
    border: none;
    font-size: 1.5rem;
    cursor: pointer;
    color: var(--text-light);
    width: 32px;
    height: 32px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
  }
  .modal-close:hover { background: var(--border); color: var(--text); }
  .modal-footer {
    display: flex;
    gap: 0.75rem;
    justify-content: flex-end;
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 2px solid var(--border);
    flex-wrap: wrap;
  }
  
  .toast-container { position: fixed; top: 90px; right: 20px; z-index: 2000; display: flex; flex-direction: column; gap: 0.5rem; }
  .toast {
    background: var(--card);
    padding: 0.9rem 1.2rem;
    border-radius: 10px;
    box-shadow: var(--shadow-lg);
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-width: 250px;
    animation: slideIn 0.3s;
    border-left: 4px solid var(--success);
  }
  .toast.error { border-left-color: var(--danger); }
  .toast.warning { border-left-color: var(--warning); }
  @keyframes slideIn {
    from { transform: translateX(400px); opacity: 0; }
    to { transform: translateX(0); opacity: 1; }
  }
  
  .timeline { position: relative; padding-left: 2rem; }
  .timeline::before { content: ''; position: absolute; left: 8px; top: 0; bottom: 0; width: 2px; background: var(--border); }
  .timeline-item { position: relative; padding-bottom: 1.25rem; }
  .timeline-dot { position: absolute; left: -1.85rem; top: 0.2rem; width: 18px; height: 18px; border-radius: 50%; background: var(--primary); border: 3px solid white; box-shadow: 0 0 0 2px var(--primary); }
  .timeline-content { background: #f8fafc; padding: 0.85rem 1rem; border-radius: 10px; border-left: 3px solid var(--primary); }
  .timeline-time { font-size: 0.75rem; color: var(--text-light); margin-bottom: 0.2rem; }
  .timeline-text { font-size: 0.9rem; }
  
  .layers-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem; }
  .layer-card { background: linear-gradient(135deg, var(--card) 0%, #f8fafc 100%); padding: 1.5rem; border-radius: 14px; border: 2px solid var(--border); transition: all 0.2s; cursor: pointer; }
  .layer-card:hover { border-color: var(--primary); transform: translateY(-3px); box-shadow: var(--shadow-lg); }
  .layer-number { display: inline-block; background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%); color: white; width: 36px; height: 36px; border-radius: 10px; text-align: center; line-height: 36px; font-weight: 700; margin-bottom: 0.75rem; }
  .layer-title { font-size: 1.1rem; font-weight: 700; margin-bottom: 0.5rem; }
  .layer-desc { color: var(--text-light); font-size: 0.88rem; line-height: 1.6; }
  
  .welcome-banner { background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 50%, #ec4899 100%); color: white; padding: 2rem; border-radius: 16px; margin-bottom: 1.5rem; position: relative; overflow: hidden; }
  .welcome-banner::before { content: ''; position: absolute; right: -50px; top: -50px; width: 200px; height: 200px; background: rgba(255,255,255,0.1); border-radius: 50%; }
  .welcome-banner::after { content: ''; position: absolute; right: 50px; bottom: -80px; width: 150px; height: 150px; background: rgba(255,255,255,0.08); border-radius: 50%; }
  .welcome-title { font-size: 1.6rem; font-weight: 800; margin-bottom: 0.4rem; position: relative; }
  .welcome-subtitle { opacity: 0.95; font-size: 1rem; position: relative; max-width: 600px; }
  
  .empty-state { text-align: center; padding: 3rem 1rem; color: var(--text-light); }
  .empty-icon { font-size: 3rem; margin-bottom: 1rem; opacity: 0.5; }
  .empty-title { font-size: 1.1rem; font-weight: 600; margin-bottom: 0.4rem; color: var(--text); }
  
  .search-bar { position: relative; margin-bottom: 1rem; }
