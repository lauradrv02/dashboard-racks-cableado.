  // HELPERS
  function getRackDevices(rackId) { return devices.filter(d => d.rackId === rackId); }

  function getRackStats(rackId) {
    const devs = getRackDevices(rackId);
    const rack = racks.find(r => r.id === rackId);
    const used = devs.reduce((sum, d) => sum + d.height, 0);
    const total = rack ? rack.size : 42;
    const percent = total > 0 ? Math.round((used / total) * 100) : 0;
    return {
      used, total, percent,
      active: devs.filter(d => d.status === 'active').length,
      maintenance: devs.filter(d => d.status === 'maintenance').length,
      pending: devs.filter(d => d.status === 'pending').length,
      devices: devs.length
    };
  }

  function getDeviceIcon(type) {
    const icons = { 
      Switch: '🔀', 'Patch Panel': '🔌', Organizador: '📋', 
      UPS: '🔋', Servidor: '💻', Reserva: '📦' 
    };
    return icons[type] || '🔧';
  }

  function getDeviceIdentifier(d) {
    if (d.mac && d.serial) return `${d.mac} · ${d.serial}`;
    if (d.mac) return d.mac;
    if (d.serial) return d.serial;
    return '';
  }

  // MAC VALIDATION
  function validateMac() {
    const input = document.getElementById('device-mac');
    const hint = document.getElementById('mac-hint');
    const value = input.value.trim();
    
    if (!value) {
      input.classList.remove('invalid');
      hint.textContent = 'Formato: XX:XX:XX:XX:XX:XX';
      hint.style.color = 'var(--text-light)';
      return true;
    }
    
    // Acepta varios formatos: XX:XX:XX:XX:XX:XX, XX-XX-XX-XX-XX-XX, XXXXXXXXXXXX
    const macRegex = /^([0-9A-Fa-f]{2}[:-]){5}([0-9A-Fa-f]{2})$|^([0-9A-Fa-f]{12})$/;
    const isValid = macRegex.test(value);
    
    if (isValid) {
      input.classList.remove('invalid');
      hint.textContent = '✅ Formato válido';
      hint.style.color = 'var(--success)';
      return true;
    } else {
      input.classList.add('invalid');
      hint.textContent = '⚠️ Formato inválido. Usa AA:BB:CC:DD:EE:FF';
      hint.style.color = 'var(--danger)';
      return false;
    }
  }

