<div class="toast-container" id="toast-container"></div>

<script>
  // STATE
  let racks = JSON.parse(localStorage.getItem('rackscope_racks') || '[]');
  let devices = JSON.parse(localStorage.getItem('rackscope_devices') || '[]');
  let mappings = JSON.parse(localStorage.getItem('rackscope_mappings') || '[]');
  let log = JSON.parse(localStorage.getItem('rackscope_log') || '[]');
  let customTypes = JSON.parse(localStorage.getItem('rackscope_custom_types') || '[]');
  let activeRackId = localStorage.getItem('rackscope_active_rack') || null;
  let currentDetailFilter = null;

  const DEFAULT_TYPES = ['Switch', 'Patch Panel', 'Organizador', 'UPS', 'Servidor', 'Reserva'];

  // MIGRATION
  if (devices.length > 0 && devices.some(d => !d.rackId)) {
    if (racks.length === 0) {
      racks.push({
        id: Date.now(),
        name: 'Rack Principal',
        location: 'Ubicación por defecto',
        size: 42,
        description: 'Rack migrado automáticamente'
      });
    }
    const defaultRackId = racks[0].id;
    devices = devices.map(d => ({ 
      ...d, 
      rackId: d.rackId || defaultRackId,
      mac: d.mac || '',
      serial: d.serial || ''
    }));
    persist();
  }

  // TABS
  function switchTab(id, btn) {
    document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
    document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
    btn.classList.add('active');
    document.getElementById(id).classList.add('active');
    if (id === 'rack-view') renderRackView();
  }

  // TOAST
  function toast(msg, type = 'success') {
    const container = document.getElementById('toast-container');
    const t = document.createElement('div');
    t.className = 'toast ' + type;
    const icon = type === 'success' ? '✅' : type === 'error' ? '❌' : '⚠️';
    t.innerHTML = `<span>${icon}</span><span>${msg}</span>`;
    container.appendChild(t);
    setTimeout(() => {
      t.style.animation = 'slideIn 0.3s reverse';
      setTimeout(() => t.remove(), 300);
    }, 3000);
  }

  // LOG
  function addLog(action) {
    log.unshift({ time: new Date().toLocaleString('es-MX'), action: action });
    if (log.length > 50) log = log.slice(0, 50);
    localStorage.setItem('rackscope_log', JSON.stringify(log));
