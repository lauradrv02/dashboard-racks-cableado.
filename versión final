        <div>
          <div class="rack-legend">
            <h3 style="margin-bottom: 1rem; font-size: 1rem;">🎨 Leyenda</h3>
            <div class="legend-item">
              <div class="legend-dot free"></div>
              <div class="legend-label">Libre</div>
              <div class="legend-count">${stats.total - stats.used}</div>
            </div>
            <div class="legend-item">
              <div class="legend-dot active"></div>
              <div class="legend-label">Activo</div>
              <div class="legend-count">${stats.active}</div>
            </div>
            <div class="legend-item">
              <div class="legend-dot maintenance"></div>
              <div class="legend-label">Mantenimiento</div>
              <div class="legend-count">${stats.maintenance}</div>
            </div>
            <div class="legend-item">
              <div class="legend-dot pending"></div>
              <div class="legend-label">Pendiente</div>
              <div class="legend-count">${stats.pending}</div>
            </div>
          </div>
          <button class="btn btn-primary btn-lg" style="width: 100%; margin-top: 1rem; justify-content: center;" onclick="openDeviceModal()">
            ➕ Agregar Equipo a este Rack
          </button>
          <button class="btn btn-secondary btn-lg" style="width: 100%; margin-top: 0.5rem; justify-content: center;" onclick="openRackModal(${rack.id})">
            ✏️ Editar Rack
          </button>
        </div>
      </div>
    `;
  }

  // INVENTORY
  function renderInventory() {
    const filterSelect = document.getElementById('filter-rack');
    const currentFilter = filterSelect.value;
    filterSelect.innerHTML = '<option value="">Todos los racks</option>' + 
      racks.map(r => `<option value="${r.id}">${r.name} (${r.location})</option>`).join('');
    filterSelect.value = currentFilter;

    const search = document.getElementById('search-inventory').value.toLowerCase();
    const filterRack = filterSelect.value;
    const tbody = document.getElementById('inventory-tbody');
    
    let filtered = devices.filter(d => {
      const idStr = getDeviceIdentifier(d).toLowerCase();
      const matchSearch = d.name.toLowerCase().includes(search) ||
        d.type.toLowerCase().includes(search) ||
        String(d.u).includes(search) ||
        idStr.includes(search);
      const matchRack = !filterRack || d.rackId === parseInt(filterRack);
      return matchSearch && matchRack;
    });

    if (filtered.length === 0) {
      tbody.innerHTML = `<tr><td colspan="9"><div class="empty-state"><div class="empty-icon">📦</div><div class="empty-title">${devices.length === 0 ? 'Sin equipos aún' : 'Sin resultados'}</div><div>${devices.length === 0 ? 'Agrega tu primer equipo' : 'Intenta con otra búsqueda'}</div></div></td></tr>`;
      return;
    }

    const statusBadge = {
      active: '<span class="badge badge-active"><span class="badge-dot"></span>Activo</span>',
      maintenance: '<span class="badge badge-maintenance"><span class="badge-dot"></span>Mantenimiento</span>',
      pending: '<span class="badge badge-pending"><span class="badge-dot"></span>Pendiente</span>'
    };

    tbody.innerHTML = filtered.map(d => {
      const rack = racks.find(r => r.id === d.rackId);
      const identifier = getDeviceIdentifier(d);
      return `
        <tr>
          <td><strong>#${d.id}</strong></td>
          <td>${rack ? rack.name : '—'}</td>
          <td><strong>${d.name}</strong></td>
          <td>${getDeviceIcon(d.type)} ${d.type}</td>
          <td>${identifier ? `<span class="badge badge-id" title="${identifier}">🔖 ${identifier.length > 20 ? identifier.substring(0, 20) + '...' : identifier}</span>` : '<span style="color: var(--text-light);">—</span>'}</td>
          <td>U${d.u}-${d.u + d.height - 1}</td>
          <td>${statusBadge[d.status]}</td>
          <td>${d.circuit || '—'}</td>
          <td>
            <button class="action-btn action-edit" onclick="editDevice(${d.id})">✏️</button>
            <button class="action-btn action-delete" onclick="deleteDevice(${d.id})">🗑️</button>
          </td>
        </tr>
      `;
    }).join('');
  }

  // MAPPING
  function renderMappings() {
    const tbody = document.getElementById('mapping-tbody');
    if (mappings.length === 0) {
      tbody.innerHTML = `<tr><td colspan="6"><div class="empty-state"><div class="empty-icon">🔗</div><div class="empty-title">Sin mapeos</div><div>Relaciona puertos con servicios</div></div></td></tr>`;
      return;
    }
    tbody.innerHTML = mappings.map(m => {
      const dev = devices.find(d => d.id === m.deviceId);
      const rack = dev ? racks.find(r => r.id === dev.rackId) : null;
      return `
        <tr>
          <td><strong>${m.port}</strong></td>
          <td>${rack ? rack.name : '—'}</td>
          <td>${dev ? dev.name : '—'}</td>
          <td>${m.service}</td>
          <td>${m.vlan || '—'}</td>
          <td>
            <button class="action-btn action-edit" onclick="editMapping(${m.id})">✏️</button>
            <button class="action-btn action-delete" onclick="deleteMapping(${m.id})">🗑️</button>
          </td>
        </tr>
      `;
    }).join('');
  }

  // MODAL DEVICE
  function openDeviceModal() {
    if (racks.length === 0) {
      toast('Primero crea un rack', 'warning');
      openRackModal();
      return;
    }
    document.getElementById('device-modal').classList.add('active');
    document.getElementById('device-modal-title').textContent = '➕ Agregar Equipo';
    document.getElementById('device-form').reset();
    document.getElementById('device-id').value = '';
    document.getElementById('device-height').value = 1;
    document.getElementById('custom-type-wrapper').classList.remove('active');
    
    const select = document.getElementById('device-rack');
    select.innerHTML = racks.map(r => 
      `<option value="${r.id}" ${r.id === activeRackId ? 'selected' : ''}>${r.name} — ${r.location} (${r.size}U)</option>`
    ).join('');
    
    renderTypeSelect();
    updateUMax();
    select.onchange = updateUMax;
  }

  function updateUMax() {
    const rackId = parseInt(document.getElementById('device-rack').value);
    const rack = racks.find(r => r.id === rackId);
    if (rack) {
      document.getElementById('device-u').max = rack.size;
      document.getElementById('device-height').max = rack.size;
    }
  }

  function openDeviceModalWithU(u) {
    openDeviceModal();
    document.getElementById('device-u').value = u;
  }

  function closeDeviceModal() {
    document.getElementById('device-modal').classList.remove('active');
  }

  function editDevice(id) {
    const d = devices.find(x => x.id === id);
    if (!d) return;
    openDeviceModal();
    document.getElementById('device-modal-title').textContent = '✏️ Editar Equipo';
    document.getElementById('device-id').value = d.id;
    document.getElementById('device-rack').value = d.rackId;
    document.getElementById('device-name').value = d.name;
    
    // Si es un tipo personalizado, seleccionarlo
    const typeSelect = document.getElementById('device-type');
    const isCustom = !DEFAULT_TYPES.includes(d.type) && d.type !== '__CUSTOM__';
    if (isCustom) {
      // Asegurar que el tipo personalizado está en la lista
      if (!customTypes.includes(d.type)) {
        customTypes.push(d.type);
        localStorage.setItem('rackscope_custom_types', JSON.stringify(customTypes));
      }
      renderTypeSelect();
      typeSelect.value = d.type;
    } else {
      typeSelect.value = d.type;
    }
    
    document.getElementById('device-u').value = d.u;
    document.getElementById('device-height').value = d.height;
    document.getElementById('device-status').value = d.status;
    document.getElementById('device-mac').value = d.mac || '';
    document.getElementById('device-serial').value = d.serial || '';
    document.getElementById('device-circuit').value = d.circuit || '';
    document.getElementById('device-service').value = d.service || '';
    document.getElementById('device-validation').value = d.validation || 'CONFIRMADO';
    updateUMax();
    validateMac();
  }

  function saveDevice(e) {
    e.preventDefault();
    const id = document.getElementById('device-id').value;
    const rackId = parseInt(document.getElementById('device-rack').value);
    const rack = racks.find(r => r.id === rackId);
    
    let deviceType = document.getElementById('device-type').value;
    
    // Manejar tipo personalizado
    if (deviceType === '__CUSTOM__') {
      const customType = document.getElementById('device-custom-type').value.trim();
      if (!customType) {
        toast('Escribe un nombre para el tipo personalizado', 'error');
        return;
      }
      deviceType = customType;
      
      // Guardar como favorito si se marcó
      if (document.getElementById('save-as-favorite').checked) {
        if (!customTypes.includes(customType)) {
          customTypes.push(customType);
          localStorage.setItem('rackscope_custom_types', JSON.stringify(customTypes));
          toast(`Tipo "${customType}" guardado como favorito`, 'success');
        }
      }
    }
    
    // Validar MAC si se proporcionó
    const mac = document.getElementById('device-mac').value.trim();
    if (mac && !validateMac()) {
      toast('Formato de MAC inválido', 'error');
      return;
    }
    
    const data = {
      id: id ? parseInt(id) : Date.now(),
      rackId: rackId,
      name: document.getElementById('device-name').value,
      type: deviceType,
      u: parseInt(document.getElementById('device-u').value),
      height: parseInt(document.getElementById('device-height').value),
      status: document.getElementById('device-status').value,
      mac: mac,
      serial: document.getElementById('device-serial').value.trim(),
      circuit: document.getElementById('device-circuit').value,
      service: document.getElementById('device-service').value,
      validation: document.getElementById('device-validation').value
    };

    if (data.u + data.height - 1 > rack.size) {
      toast(`El equipo excede el tamaño del rack (${rack.size}U)`, 'error');
      return;
    }

    const rackDevices = getRackDevices(rackId);
    const overlap = rackDevices.find(d => 
      d.id !== data.id &&
      ((data.u >= d.u && data.u < d.u + d.height) ||
       (data.u + data.height > d.u && data.u <= d.u + d.height))
    );
    if (overlap) {
      toast(`Conflicto: se superpone con "${overlap.name}"`, 'error');
      return;
    }

    if (id) {
      devices = devices.map(d => d.id === data.id ? data : d);
      addLog(`✏️ Editado: ${data.name} en ${rack.name} U${data.u}`);
      toast('Equipo actualizado');
    } else {
      devices.push(data);
      addLog(`➕ Agregado: ${data.name} en ${rack.name} U${data.u} (${data.height}U)`);
      toast('Equipo agregado');
    }
    persist();
    closeDeviceModal();
  }

  function deleteDevice(id) {
    const d = devices.find(x => x.id === id);
    if (!d) return;
    if (!confirm(`¿Eliminar "${d.name}"?`)) return;
    devices = devices.filter(x => x.id !== id);
    mappings = mappings.filter(m => m.deviceId !== id);
    addLog(`🗑️ Eliminado: ${d.name}`);
    toast('Equipo eliminado', 'warning');
    persist();
  }

  // MODAL MAPPING
  function openMappingModal() {
    if (devices.length === 0) {
      toast('Primero agrega equipos', 'warning');
      return;
    }
    const select = document.getElementById('mapping-device');
    select.innerHTML = '<option value="">Seleccionar equipo...</option>' + 
      devices.map(d => {
        const rack = racks.find(r => r.id === d.rackId);
        return `<option value="${d.id}">${d.name} — ${rack ? rack.name : ''}</option>`;
      }).join('');
    document.getElementById('mapping-modal').classList.add('active');
    document.getElementById('mapping-form').reset();
    document.getElementById('mapping-id').value = '';
  }

  function closeMappingModal() { document.getElementById('mapping-modal').classList.remove('active'); }

  function editMapping(id) {
    const m = mappings.find(x => x.id === id);
    if (!m) return;
    openMappingModal();
    document.getElementById('mapping-id').value = m.id;
    document.getElementById('mapping-device').value = m.deviceId;
    document.getElementById('mapping-port').value = m.port;
    document.getElementById('mapping-service').value = m.service;
    document.getElementById('mapping-vlan').value = m.vlan || '';
  }

  function saveMapping(e) {
    e.preventDefault();
    const id = document.getElementById('mapping-id').value;
    const data = {
      id: id ? parseInt(id) : Date.now(),
      deviceId: parseInt(document.getElementById('mapping-device').value),
      port: document.getElementById('mapping-port').value,
      service: document.getElementById('mapping-service').value,
      vlan: document.getElementById('mapping-vlan').value
    };
    if (id) {
      mappings = mappings.map(m => m.id === data.id ? data : m);
      addLog(`✏️ Mapeo editado: ${data.port}`);
    } else {
      mappings.push(data);
      addLog(`➕ Mapeo agregado: ${data.port}`);
    }
    persist();
    closeMappingModal();
    toast('Mapeo guardado');
  }

  function deleteMapping(id) {
    if (!confirm('¿Eliminar este mapeo?')) return;
    mappings = mappings.filter(x => x.id !== id);
    addLog(`🗑️ Mapeo eliminado`);
    toast('Mapeo eliminado', 'warning');
    persist();
  }

  // PERSISTENCE
  function persist() {
    localStorage.setItem('rackscope_racks', JSON.stringify(racks));
    localStorage.setItem('rackscope_devices', JSON.stringify(devices));
    localStorage.setItem('rackscope_mappings', JSON.stringify(mappings));
    renderAll();
  }

  function renderAll() {
    renderDashboard();
    renderRacksGrid();
    renderRackView();
    renderInventory();
    renderMappings();
    renderLog();
  }

  function saveLocal() {
    const data = { racks, devices, mappings, log, customTypes, date: new Date().toISOString() };
    const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `rackscope-backup-${new Date().toISOString().slice(0,10)}.json`;
    a.click();
    toast('Copia descargada');
  }

  function loadLocal() {
    const input = document.createElement('input');
    input.type = 'file';
    input.accept = '.json';
    input.onchange = e => {
      const file = e.target.files[0];
      const reader = new FileReader();
      reader.onload = ev => {
        try {
          const data = JSON.parse(ev.target.result);
          racks = data.racks || [];
          devices = data.devices || [];
          mappings = data.mappings || [];
          log = data.log || [];
          customTypes = data.customTypes || [];
          localStorage.setItem('rackscope_custom_types', JSON.stringify(customTypes));
          persist();
          toast('Copia cargada correctamente');
        } catch (err) {
          toast('Error al cargar archivo', 'error');
        }
      };
      reader.readAsText(file);
    };
    input.click();
  }

  function resetAll() {
    if (!confirm('¿Reiniciar TODO? Se perderán todos los datos.')) return;
    racks = [];
    devices = [];
    mappings = [];
    log = [];
    customTypes = [];
    activeRackId = null;
    localStorage.removeItem('rackscope_racks');
    localStorage.removeItem('rackscope_devices');
    localStorage.removeItem('rackscope_mappings');
    localStorage.removeItem('rackscope_log');
    localStorage.removeItem('rackscope_custom_types');
    localStorage.removeItem('rackscope_active_rack');
    renderAll();
    toast('Todo reiniciado', 'warning');
  }

  // INIT
  renderAll();
</script>

</body>
