  // RACK CRUD
  function openRackModal(id = null) {
    document.getElementById('rack-modal').classList.add('active');
    document.getElementById('rack-form').reset();
    document.getElementById('rack-id').value = '';
    document.getElementById('rack-size').value = 42;
    
    if (id) {
      const r = racks.find(x => x.id === id);
      if (!r) return;
      document.getElementById('rack-modal-title').textContent = '✏️ Editar Rack';
      document.getElementById('rack-id').value = r.id;
      document.getElementById('rack-name').value = r.name;
      document.getElementById('rack-location').value = r.location;
      document.getElementById('rack-size').value = r.size;
      document.getElementById('rack-description').value = r.description || '';
    } else {
      document.getElementById('rack-modal-title').textContent = '➕ Nuevo Rack';
    }
  }

  function closeRackModal() { document.getElementById('rack-modal').classList.remove('active'); }

  function saveRack(e) {
    e.preventDefault();
    const id = document.getElementById('rack-id').value;
    const data = {
      id: id ? parseInt(id) : Date.now(),
      name: document.getElementById('rack-name').value,
      location: document.getElementById('rack-location').value,
      size: parseInt(document.getElementById('rack-size').value),
      description: document.getElementById('rack-description').value
    };

    if (id) {
      const existingDevices = getRackDevices(data.id);
      const maxU = existingDevices.length > 0 ? Math.max(0, ...existingDevices.map(d => d.u + d.height - 1)) : 0;
      if (maxU > data.size) {
        toast(`No puedes reducir el tamaño: hay equipos hasta la U${maxU}`, 'error');
        return;
      }
    }

    if (id) {
      racks = racks.map(r => r.id === data.id ? data : r);
      addLog(`✏️ Rack editado: ${data.name}`);
      toast('Rack actualizado');
    } else {
      racks.push(data);
      addLog(`➕ Rack creado: ${data.name} en ${data.location} (${data.size}U)`);
      toast('Rack creado');
      if (!activeRackId) activeRackId = data.id;
    }
    persist();
    closeRackModal();
  }

  function deleteRack(id) {
    const r = racks.find(x => x.id === id);
    if (!r) return;
    const devs = getRackDevices(id);
    const msg = devs.length > 0 
      ? `¿Eliminar "${r.name}" y sus ${devs.length} equipos?`
      : `¿Eliminar "${r.name}"?`;
    if (!confirm(msg)) return;
    
    racks = racks.filter(x => x.id !== id);
    devices = devices.filter(d => d.rackId !== id);
    mappings = mappings.filter(m => {
      const dev = devices.find(d => d.id === m.deviceId);
      return dev !== undefined;
    });
    
    if (activeRackId === id) activeRackId = racks.length > 0 ? racks[0].id : null;
    
    addLog(`🗑️ Rack eliminado: ${r.name}`);
    toast('Rack eliminado', 'warning');
    persist();
  }

