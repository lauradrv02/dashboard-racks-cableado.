<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>RackScope IA - Dashboard de Racks</title>
  <style>
    :root {
      --bg-main: #0b132b;
      --bg-card: #1c2541;
      --bg-elevated: #3a506b;
      --text-main: #edf2f4;
      --text-muted: #8d99ae;
      --accent: #48cae4;
      --accent-hover: #00b4d8;
      --status-active: #2a9d8f;
      --status-maint: #e9c46a;
      --status-pending: #e76f51;
      --border-color: #2b3a55;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
    body { background-color: var(--bg-main); color: var(--text-main); padding: 20px; }

    header { display: flex; justify-content: space-between; align-items: center; padding-bottom: 20px; border-bottom: 1px solid var(--border-color); margin-bottom: 20px; }
    h1 { font-size: 1.5rem; color: var(--accent); }
    
    .actions-bar { display: flex; gap: 10px; margin-bottom: 20px; }
    button { background: var(--accent); color: #000; border: none; padding: 8px 16px; border-radius: 4px; font-weight: bold; cursor: pointer; transition: 0.2s; }
    button:hover { background: var(--accent-hover); }
    button.btn-danger { background: var(--status-pending); color: #fff; }

    .grid-container { display: grid; grid-template-columns: 320px 1fr 350px; gap: 20px; }
    
    .card { background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 8px; padding: 15px; }
    .card-title { font-size: 1.1rem; margin-bottom: 15px; color: var(--accent); border-bottom: 1px solid var(--border-color); padding-bottom: 5px; }

    /* Rack Visualizer */
    .rack-frame { background: #000; border: 4px solid #4a5568; border-radius: 4px; padding: 5px; display: flex; flex-direction: column; gap: 2px; }
    .unit-slot { display: flex; height: 32px; border: 1px dashed #334155; align-items: center; font-size: 0.8rem; padding: 0 5px; background: #0f172a; }
    .unit-number { width: 35px; font-weight: bold; color: var(--text-muted); border-right: 1px solid #334155; }
    .unit-content { flex: 1; padding-left: 10px; display: flex; justify-content: space-between; align-items: center; }

    .eq-active { background: #1e3a8a; border: 1px solid #3b82f6; }
    .eq-maintenance { background: #78350f; border: 1px solid #f59e0b; }
    .eq-pending { background: #701a75; border: 1px solid #d946ef; }
    .unit-reserved { background: repeating-linear-gradient(45deg, #1e293b, #1e293b 10px, #0f172a 10px, #0f172a 20px); }

    /* Tables */
    table { width: 100%; border-collapse: collapse; font-size: 0.85rem; margin-top: 10px; }
    th, td { text-align: left; padding: 8px; border-bottom: 1px solid var(--border-color); }
    th { color: var(--text-muted); background: var(--bg-elevated); }

    .badge { padding: 2px 6px; border-radius: 3px; font-size: 0.75rem; font-weight: bold; }
    .badge-active { background: var(--status-active); color: #fff; }
    .badge-maint { background: var(--status-maint); color: #000; }
    .badge-pending { background: var(--status-pending); color: #fff; }

    .bitacora-list { list-style: none; font-size: 0.85rem; }
    .bitacora-item { padding: 8px 0; border-bottom: 1px solid var(--border-color); }
    .bitacora-date { font-size: 0.75rem; color: var(--text-muted); }
  </style>
</head>
<body>

  <header>
    <div>
      <h1>RackScope IA — Cableado Estructurado</h1>
      <small style="color: var(--text-muted)">Inventario y Modelo de 3 Capas (Física, Lógica y Eléctrica)</small>
    </div>
    <div class="actions-bar">
      <button onclick="exportarJSON()">Exportar JSON</button>
      <button onclick="document.getElementById('fileInput').click()">Importar JSON</button>
      <input type="file" id="fileInput" style="display:none" onchange="importarJSON(event)">
      <button class="btn-danger" onclick="restaurarDemo()">Restaurar Demo</button>
    </div>
  </header>

  <main class="grid-container">
    <!-- Columna 1: Vista Gráfica del Rack -->
    <section class="card">
      <h2 class="card-title">Rack demostrativo 01 (18U)</h2>
      <div id="rackVisualizer" class="rack-frame">
        <!-- Renderizado dinámico vía JavaScript -->
      </div>
    </section>

    <!-- Columna 2: Tabla de Inventario de Equipos -->
    <section class="card">
      <h2 class="card-title">Inventario de Equipos</h2>
      <table id="tablaEquipos">
        <thead>
          <tr>
            <th>ID</th>
            <th>Equipo</th>
            <th>Rack/U</th>
            <th>Estado</th>
            <th>Circuito</th>
            <th>Confianza</th>
          </tr>
        </thead>
        <tbody>
          <!-- Renderizado dinámico -->
        </tbody>
      </table>

      <h2 class="card-title" style="margin-top: 25px;">Interfaces y Servicios</h2>
      <table id="tablaInterfaces">
        <thead>
          <tr>
            <th>Equipo</th>
            <th>Puerto</th>
            <th>Servicio</th>
            <th>Destino</th>
          </tr>
        </thead>
        <tbody>
          <!-- Renderizado dinámico -->
        </tbody>
      </table>
    </section>

    <!-- Columna 3: Bitácora de Cambios y Alertas -->
    <section class="card">
      <h2 class="card-title">Alertas</h2>
      <div id="alertasBox" style="background: #451a03; border: 1px solid #b45309; padding: 10px; border-radius: 4px; margin-bottom: 20px; font-size: 0.85rem;">
        ⚠️ EQ-004: Circuito de energía en estado [PENDIENTE].
      </div>

      <h2 class="card-title">Bitácora Técnica</h2>
      <ul id="bitacoraList" class="bitacora-list">
        <!-- Renderizado dinámico -->
      </ul>
    </section>
  </main>

  <script>
    // Datos por defecto (Fuente de verdad inicial)
    const datosIniciales = {
      racks: [{
        id: "R01",
        nombre: "Rack demostrativo 01",
        capacidadU: 18,
        equipos: [
          { id: "EQ-001", nombre: "Patch panel cobre", tipo: "Patch panel", uInicio: 18, uTamano: 1, estado: "active", circuito: "No aplica", confianza: "CONFIRMADO" },
          { id: "EQ-002", nombre: "Organizador horizontal", tipo: "Organizador", uInicio: 17, uTamano: 1, estado: "active", circuito: "No aplica", confianza: "CONFIRMADO" },
          { id: "EQ-003", nombre: "Switch de acceso", tipo: "Switch", uInicio: 16, uTamano: 1, estado: "maintenance", circuito: "CIR-A [EJEMPLO]", confianza: "INFERIDO" },
          { id: "EQ-004", nombre: "UPS de rack", tipo: "UPS", uInicio: 2, uTamano: 2, estado: "active", circuito: "[PENDIENTE]", confianza: "PENDIENTE" }
        ]
      }],
      interfaces: [
        { equipoId: "EQ-003", puerto: "Gi1/0/1", servicio: "Uplink [EJEMPLO]", destino: "[PENDIENTE]" },
        { equipoId: "EQ-003", puerto: "Gi1/0/2", servicio: "Usuario [EJEMPLO]", destino: "PP-01/01" }
      ],
      bitacora: [
        { fecha: "24/09/2026 14:00", usuario: "Docente", accion: "Crear datos de demostración" }
      ]
    };

    let appData = JSON.parse(localStorage.getItem('rackScopeData')) || datosIniciales;

    function guardarDatos() {
      localStorage.setItem('rackScopeData', JSON.stringify(appData));
      render();
    }

    function render() {
      renderRack();
      renderTablaEquipos();
      renderTablaInterfaces();
      renderBitacora();
    }

    function renderRack() {
      const rack = appData.racks[0];
      const container = document.getElementById('rackVisualizer');
      container.innerHTML = '';

      for (let u = rack.capacidadU; u >= 1; u--) {
        const equipo = rack.equipos.find(e => u >= e.uInicio && u < e.uInicio + e.uTamano);
        const slot = document.createElement('div');
        slot.className = 'unit-slot';

        if (equipo) {
          if (u === equipo.uInicio + equipo.uTamano - 1) {
            let estadoClass = equipo.estado === 'active' ? 'eq-active' : (equipo.estado === 'maintenance' ? 'eq-maintenance' : 'eq-pending');
            slot.className += ` ${estadoClass}`;
            slot.innerHTML = `<span class="unit-number">U${u}</span><div class="unit-content"><strong>${equipo.nombre}</strong><span class="badge badge-${equipo.estado}">${equipo.estado}</span></div>`;
          } else {
            let estadoClass = equipo.estado === 'active' ? 'eq-active' : (equipo.estado === 'maintenance' ? 'eq-maintenance' : 'eq-pending');
            slot.className += ` ${estadoClass}`;
            slot.innerHTML = `<span class="unit-number">U${u}</span><div class="unit-content"><small style="color:var(--text-muted)">(Ocupado por ${equipo.id})</small></div>`;
          }
        } else {
          slot.innerHTML = `<span class="unit-number">U${u}</span><div class="unit-content"><span style="color: #475569;">Libre</span></div>`;
        }
        container.appendChild(slot);
      }
    }

    function renderTablaEquipos() {
      const tbody = document.querySelector('#tablaEquipos tbody');
      tbody.innerHTML = '';
      appData.racks[0].equipos.forEach(e => {
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td><strong>${e.id}</strong></td>
          <td>${e.nombre}<br><small style="color:var(--text-muted)">${e.tipo}</small></td>
          <td>R01 / U${e.uInicio}</td>
          <td><span class="badge badge-${e.estado}">${e.estado}</span></td>
          <td>${e.circuito}</td>
          <td><small>${e.confianza}</small></td>
        `;
        tbody.appendChild(tr);
      });
    }

    function renderTablaInterfaces() {
      const tbody = document.querySelector('#tablaInterfaces tbody');
      tbody.innerHTML = '';
      appData.interfaces.forEach(i => {
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td>${i.equipoId}</td>
          <td>${i.puerto}</td>
          <td>${i.servicio}</td>
          <td>${i.destino}</td>
        `;
        tbody.appendChild(tr);
      });
    }

    function renderBitacora() {
      const list = document.getElementById('bitacoraList');
      list.innerHTML = '';
      appData.bitacora.forEach(b => {
        const li = document.createElement('li');
        li.className = 'bitacora-item';
        li.innerHTML = `<div><strong>${b.accion}</strong></div><div class="bitacora-date">${b.fecha} - ${b.usuario}</div>`;
        list.appendChild(li);
      });
    }

    function exportarJSON() {
      const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(appData, null, 2));
      const downloadAnchor = document.createElement('a');
      downloadAnchor.setAttribute("href", dataStr);
      downloadAnchor.setAttribute("download", "inventario-respaldo.json");
      document.body.appendChild(downloadAnchor);
      downloadAnchor.click();
      downloadAnchor.remove();
    }

    function importarJSON(event) {
      const reader = new FileReader();
      reader.onload = function(e) {
        try {
          appData = JSON.parse(e.target.result);
          guardarDatos();
          alert('Inventario importado con éxito.');
        } catch (err) {
          alert('Error al leer el archivo JSON.');
        }
      };
      reader.readAsText(event.target.files[0]);
    }

    function restaurarDemo() {
      if (confirm('¿Deseas restaurar los datos de prueba iniciales?')) {
        appData = JSON.parse(JSON.stringify(datosIniciales));
        guardarDatos();
      }
    }

    // Inicializar
    render();
  </script>
</body>
</html>
