<!-- TOAST CONTAINER -->
<div class="toast-container" id="toast-container"></div>

<script>
  // STATE
  let devices = JSON.parse(localStorage.getItem('rackscope_devices') || '[]');
  let mappings = JSON.parse(localStorage.getItem('rackscope_mappings') || '[]');
  let log = JSON.parse(localStorage.getItem('rackscope_log') || '[]');
  const RACK_SIZE = 42;

  // TABS
  function switchTab(id, btn) {
    document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
    document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
    btn.classList.add('active');
    document.getElementById(id).classList.add('active');
  }

  // TOAST
  function toast(msg, type = 'success') {
    const container = document.getElementById('toast-container');
    const t = document.createElement('div');
    t.className = 'toast ' + type;
    const icon = type === 'success' ? '✅' : type === 'error' ? '❌' : '⚠️';
    t.innerHTML = `<span>${icon}</span><span>${msg}</span>`;
    container.appendChild(t);
    setTimeout(() => {
      t.style.animation = 'slideIn 0.3s reverse';
      setTimeout(() => t.remove(), 300);
    }, 3000);
  }

  // LOG
  function addLog(action) {
    log.unshift({
      time: new Date().toLocaleString('es-MX'),
      action: action
    });
    if (log.length > 50) log = log.slice(0, 50);
    localStorage.setItem('rackscope_log', JSON.stringify(log));
    renderLog();
  }

  function renderLog() {
    const container = document.getElementById('timeline');
    if (log.length === 0) {
      container.innerHTML = `<div class="empty-state"><div class="empty-icon">📝</div><div class="empty-title">Sin cambios registrados</div><div>Tus acciones aparecerán aquí</div></div>`;
      return;
    }
    container.innerHTML = log.map(l => `
      <div class="timeline-item">
        <div class="timeline-dot"></div>
        <div class="timeline-content">
          <div class="timeline-time">${l.time}</div>
          <div class="timeline-text">${l.action}</div>
        </div>
      </div>
    `).join('');
  }

  function clearLog() {
    if (confirm('¿Limpiar toda la bitácora?')) {
      log = [];
      localStorage.setItem('rackscope_log', JSON.stringify(log));
      renderLog();
      toast('Bitácora limpiada');
    }
  }

  // RACK VIEW
  function renderRack() {
    const units = document.getElementById('rack-units');
    let html = '';
    const occupied = {};
    devices.forEach(d => {
      for (let i = 0; i < d.height; i++) {
        occupied[d.u + i] = d;
      }
    });
    
    for (let u = RACK_SIZE; u >= 1; u--) {
      const dev = occupied[u];
      if (dev && dev.u === u) {
        const statusClass = dev.status === 'maintenance' ? 'maintenance' : dev.status === 'pending' ? 'pending' : 'occupied';
        const icons = { Switch: '🔀', 'Patch Panel': '🔌', Organizador: '📋', UPS: '🔋', Servidor: '💻', Reserva: '📦' };
        html += `
          <div class="rack-unit" style="grid-row: span ${dev.height};">
            <div class="u-number">${u}</div>
            <div class="u-slot ${statusClass}" onclick="editDevice(${dev.id})" style="min-height: ${dev.height * 28 + (dev.height-1)*2}px;" data-tooltip="Click para editar">
              <div class="u-slot-name">${icons[dev.type] || '📦'} ${dev.name}</div>
              <div class="u-slot-type">${dev.type} · ${dev.height}U</div>
            </div>
          </div>
        `;
      } else if (!dev) {
        html += `
          <div class="rack-unit">
            <div class="u-number">${u}</div>
            <div class="u-slot" onclick="openModalWithU(${u})">
              <span class="u-slot-empty">Libre — click para agregar</span>
            </div>
          </div>
        `;
      }
    }
    units.innerHTML = html;

    // Stats
    const used = devices.reduce((sum, d) => sum + d.height, 0);
    const percent = Math.round((used / RACK_SIZE) * 100);
    document.getElementById('rack-used').textContent = used;
    document.getElementById('rack-total').textContent = RACK_SIZE;
    document.getElementById('rack-percent').textContent = percent;
    document.getElementById('legend-free').textContent = RACK_SIZE - used;
    document.getElementById('legend-active').textContent = devices.filter(d => d.status === 'active').length;
    document.getElementById('legend-maint').textContent = devices.filter(d => d.status === 'maintenance').length;
    document.getElementById('legend-pending').textContent = devices.filter(d => d.status === 'pending').length;
  }

  // INVENTORY
  function renderInventory() {
    const search = document.getElementById('search-inventory').value.toLowerCase();
    const tbody = document.getElementById('inventory-tbody');
    const filtered = devices.filter(d => 
      d.name.toLowerCase().includes(search) ||
      d.type.toLowerCase().includes(search) ||
      String(d.u).includes(search)
    );
    if (filtered.length === 0) {
      tbody.innerHTML = `<tr><td colspan="8"><div class="empty-state"><div class="empty-icon">📦</div><div class="empty-title">${devices.length === 0 ? 'Sin equipos aún' : 'Sin resultados'}</div><div>${devices.length === 0 ? 'Agrega tu primer equipo' : 'Intenta con otra búsqueda'}</div></div></td></tr>`;
      return;
    }
    tbody.innerHTML = filtered.map(d => {
      const statusBadge = {
        active: '<span class="badge badge-active"><span class="badge-dot"></span>Activo</span>',
        maintenance: '<span class="badge badge-maintenance"><span class="badge-dot"></span>Mantenimiento</span>',
        pending: '<span class="badge badge-pending"><span class="badge-dot"></span>Pendiente</span>'
      };
      return `
        <tr>
          <td><strong>#${d.id}</strong></td>
          <td><strong>${d.name}</strong></td>
          <td>${d.type}</td>
          <td>U${d.u} - U${d.u + d.height - 1}</td>
          <td>${d.height}U</td>
          <td>${statusBadge[d.status]}</td>
          <td>${d.circuit || '—'}</td>
          <td>
            <button class="action-btn action-edit" onclick="editDevice(${d.id})">✏️ Editar</button>
            <button class="action-btn action-delete" onclick="deleteDevice(${d.id})">🗑️</button>
          </td>
        </tr>
      `;
    }).join('');
  }

  // MAPPING
  function renderMappings() {
    const tbody = document.getElementById('mapping-tbody');
    if (mappings.length === 0) {
      tbody.innerHTML = `<tr><td colspan="5"><div class="empty-state"><div class="empty-icon">🔗</div><div class="empty-title">Sin mapeos</div><div>Relaciona puertos con servicios</div></div></td></tr>`;
      return;
    }
    tbody.innerHTML = mappings.map(m => {
      const dev = devices.find(d => d.id === m.deviceId);
      return `
        <tr>
          <td><strong>${m.port}</strong></td>
          <td>${dev ? dev.name : '—'}</td>
          <td>${m.service}</td>
          <td>${m.vlan || '—'}</td>
          <td>
            <button class="action-btn action-edit" onclick="editMapping(${m.id})">✏️</button>
            <button class="action-btn action-delete" onclick="deleteMapping(${m.id})">🗑️</button>
          </td>
        </tr>
      `;
    }).join('');
  }

  // DASHBOARD
  function renderDashboard() {
    const racks = new Set(devices.map(d => d.rack || 'principal')).size;
    document.getElementById('kpi-racks').textContent = racks || (devices.length > 0 ? 1 : 0);
    document.getElementById('kpi-equipos').textContent = devices.length;
    document.getElementById('kpi-activos').textContent = devices.filter(d => d.status === 'active').length;
    document.getElementById('kpi-mant').textContent = devices.filter(d => d.status === 'maintenance').length;

    const summary = document.getElementById('quick-summary');
    if (devices.length === 0) {
      summary.innerHTML = `<div class="empty-state"><div class="empty-icon">📊</div><div class="empty-title">Aún no hay datos</div><div>Comienza agregando tu primer equipo en la pestaña "Vista de Rack"</div></div>`;
    } else {
      const byType = {};
      devices.forEach(d => { byType[d.type] = (byType[d.type] || 0) + 1; });
      summary.innerHTML = `
        <div class="kpi-grid">
          ${Object.entries(byType).map(([type, count]) => `
            <div class="kpi kpi-purple">
              <div class="kpi-label">${type}</div>
              <div class="kpi-value">${count}</div>
            </div>
          `).join('')}
        </div>
      `;
    }
  }

  // MODAL DEVICE
  function openModal() {
    document.getElementById('modal').classList.add('active');
    document.getElementById('modal-title').textContent = '➕ Agregar Equipo';
    document.getElementById('device-form').reset();
    document.getElementById('device-id').value = '';
  }

  function openModalWithU(u) {
    openModal();
    document.getElementById('device-u').value = u;
  }

  function closeModal() {
    document.getElementById('modal').classList.remove('active');
  }

  function editDevice(id) {
    const d = devices.find(x => x.id === id);
    if (!d) return;
    document.getElementById('modal').classList.add('active');
    document.getElementById('modal-title').textContent = '✏️ Editar Equipo';
    document.getElementById('device-id').value = d.id;
    document.getElementById('device-name').value = d.name;
    document.getElementById('device-type').value = d.type;
    document.getElementById('device-u').value = d.u;
    document.getElementById('device-height').value = d.height;
    document.getElementById('device-status').value = d.status;
    document.getElementById('device-circuit').value = d.circuit || '';
    document.getElementById('device-service').value = d.service || '';
    document.getElementById('device-validation').value = d.validation || 'CONFIRMADO';
  }

  function saveDevice(e) {
    e.preventDefault();
    const id = document.getElementById('device-id').value;
    const data = {
      id: id ? parseInt(id) : Date.now(),
      name: document.getElementById('device-name').value,
      type: document.getElementById('device-type').value,
      u: parseInt(document.getElementById('device-u').value),
      height: parseInt(document.getElementById('device-height').value),
      status: document.getElementById('device-status').value,
      circuit: document.getElementById('device-circuit').value,
      service: document.getElementById('device-service').value,
      validation: document.getElementById('device-validation').value
    };

    // Check overlap
    const overlap = devices.find(d => 
      d.id !== data.id &&
      ((data.u >= d.u && data.u < d.u + d.height) ||
       (data.u + data.height > d.u && data.u + data.height <= d.u + d.height))
    );
    if (overlap) {
      toast(`Conflicto: se superpone con "${overlap.name}"`, 'error');
      return;
    }

    if (id) {
      devices = devices.map(d => d.id === data.id ? data : d);
      addLog(`✏️ Editado: ${data.name} en U${data.u}`);
      toast('Equipo actualizado');
    } else {
      devices.push(data);
      addLog(`➕ Agregado: ${data.name} en U${data.u} (${data.height}U)`);
      toast('Equipo agregado');
    }
    persist();
    closeModal();
  }

  function deleteDevice(id) {
    const d = devices.find(x => x.id === id);
    if (!d) return;
    if (!confirm(`¿Eliminar "${d.name}"?`)) return;
    devices = devices.filter(x => x.id !== id);
    addLog(`🗑️ Eliminado: ${d.name}`);
    toast('Equipo eliminado', 'warning');
    persist();
  }

  // MODAL MAPPING
  function openMappingModal() {
    const select = document.getElementById('mapping-device');
    select.innerHTML = '<option value="">Seleccionar equipo...</option>' + 
      devices.map(d => `<option value="${d.id}">${d.name} (${d.type})</option>`).join('');
    document.getElementById('mapping-modal').classList.add('active');
    document.getElementById('mapping-form').reset();
    document.getElementById('mapping-id').value = '';
  }

  function closeMappingModal() {
    document.getElementById('mapping-modal').classList.remove('active');
  }

  function editMapping(id) {
    const m = mappings.find(x => x.id === id);
    if (!m) return;
    openMappingModal();
    document.getElementById('mapping-id').value = m.id;
    document.getElementById('mapping-device').value = m.deviceId;
    document.getElementById('mapping-port').value = m.port;
    document.getElementById('mapping-service').value = m.service;
    document.getElementById('mapping-vlan').value = m.vlan || '';
  }

  function saveMapping(e) {
    e.preventDefault();
    const id = document.getElementById('mapping-id').value;
    const data = {
      id: id ? parseInt(id) : Date.now(),
      deviceId: parseInt(document.getElementById('mapping-device').value),
      port: document.getElementById('mapping-port').value,
      service: document.getElementById('mapping-service').value,
      vlan: document.getElementById('mapping-vlan').value
    };
    if (id) {
      mappings = mappings.map(m => m.id === data.id ? data : m);
      addLog(`✏️ Mapeo editado: ${data.port}`);
    } else {
      mappings.push(data);
      addLog(`➕ Mapeo agregado: ${data.port}`);
    }
    persist();
    closeMappingModal();
    toast('Mapeo guardado');
  }

  function deleteMapping(id) {
    if (!confirm('¿Eliminar este mapeo?')) return;
    mappings = mappings.filter(x => x.id !== id);
    addLog(`🗑️ Mapeo eliminado`);
    toast('Mapeo eliminado', 'warning');
    persist();
  }

  // PERSISTENCE
  function persist() {
    localStorage.setItem('rackscope_devices', JSON.stringify(devices));
    localStorage.setItem('rackscope_mappings', JSON.stringify(mappings));
    renderAll();
  }

  function renderAll() {
    renderDashboard();
    renderRack();
    renderInventory();
    renderMappings();
    renderLog();
  }

  function saveLocal() {
    const data = { devices, mappings, log, date: new Date().toISOString() };
    const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `rackscope-backup-${new Date().toISOString().slice(0,10)}.json`;
    a.click();
    toast('Copia descargada');
  }

  function loadLocal() {
    const input = document.createElement('input');
    input.type = 'file';
    input.accept = '.json';
    input.onchange = e => {
      const file = e.target.files[0];
      const reader = new FileReader();
      reader.onload = ev => {
        try {
          const data = JSON.parse(ev.target.result);
          devices = data.devices || [];
          mappings = data.mappings || [];
          log = data.log || [];
          persist();
          toast('Copia cargada correctamente');
        } catch (err) {
          toast('Error al cargar archivo', 'error');
        }
      };
      reader.readAsText(file);
    };
    input.click();
  }

  function resetAll() {
    if (!confirm('¿Reiniciar TODO? Se perderán todos los datos.')) return;
    devices = [];
    mappings = [];
    log = [];
    localStorage.removeItem('rackscope_devices');
    localStorage.removeItem('rackscope_mappings');
    localStorage.removeItem('rackscope_log');
    renderAll();
    toast('Todo reiniciado', 'warning');
  }

  // INIT
  renderAll();
</script>

</body>
</html>
